#mc-build WASD content
scoreboard players reset @s wasd.variables
execute store result entity @s Rotation[0] float 1 run random value 1..360
execute store result score @s wasd.rng run random value 1..10
execute at @s[scores={wasd.rng=2}] positioned ^ ^ ^1 positioned over motion_blocking_no_leaves run summon fireball ~ ~60 ~ {ExplosionPower:2b,Motion:[0.0,-1.0,0.0],power:[0.0,-0.1,0.0],Item:{id:"minecraft:magma_block",Count:1b},Tags:["wasd.lib_entity_tick","wasd.ability","wasd.meteor_fireball"]}
