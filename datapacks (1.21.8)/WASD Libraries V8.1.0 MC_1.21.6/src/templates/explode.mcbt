template explode {
    with particles:word power:word name:raw{
block {
<%%
let double = particles*2
emit(`
particle flame ~ ~ ~ 0 0 0 0.3 ${particles} force
particle minecraft:large_smoke ~ ~ ~ 0 0 0 0.1 ${particles} force
particle smoke ~ ~ ~ 0 0 0 0.4 ${double} force
summon minecraft:creeper ~ ~-1000 ~ {Tags:["wasd.explosion"],CustomNameVisible:0b,CustomName:{"text":"a ${name}"},ExplosionRadius:${power}b,Silent:1b,Fuse:0,ignited:1b}
execute positioned ~ ~-1000 ~ as @e[type=creeper,tag=wasd.explosion,sort=nearest,limit=1] run tp @s ~ ~1001 ~
`)
%%>
        }
    }
}
