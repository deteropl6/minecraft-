# Shields Health (number of hits)
execute as @s at @s as @e[type=block_display,tag=HCDragon_Shield,distance=..10] run scoreboard players set @s HCDragon_Health 3

schedule function hcdragon:phase4/dragon_shield/dragon_shield_loop 1t replace