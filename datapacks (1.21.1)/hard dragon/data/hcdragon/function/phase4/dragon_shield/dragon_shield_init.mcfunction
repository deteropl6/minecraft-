# Spawn shields, always
execute as @s at @s unless entity @e[type=block_display,tag=HCDragon_Shield,tag=layer1,distance=..10,sort=nearest] run summon minecraft:block_display ~ ~2 ~ {Tags:["HCDragon_Shield","negative","layer1"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],scale:[7f,7f,7f],translation:[-3.5f,-3.5f,-3.5f]},block_state:{Name:glass},teleport_duration:1}
execute as @s at @s unless entity @e[type=block_display,tag=HCDragon_Shield,tag=layer2,distance=..10,sort=nearest] run summon minecraft:block_display ~ ~2 ~ {Tags:["HCDragon_Shield","negative","layer2"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],scale:[7.5f,7.5f,7.5f],translation:[-3.75f,-3.75f,-3.75f]},block_state:{Name:glass},teleport_duration:1,Rotation:[35f,-14f]}
execute as @s at @s unless entity @e[type=block_display,tag=HCDragon_Shield,tag=layer3,distance=..10,sort=nearest] run summon minecraft:block_display ~ ~2 ~ {Tags:["HCDragon_Shield","negative","layer3"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],scale:[8f,8f,8f],translation:[-4f,-4f,-4f]},block_state:{Name:glass},teleport_duration:1,Rotation:[-40f,60f]}
# Spawn additional shields for variating amount of players
# Get number of players around to determine how much shield should spawn
execute as @s at @s unless entity @e[type=block_display,tag=HCDragon_Shield,tag=layer4,distance=..10,sort=nearest] if score @s HCDragon_Misc matches 2.. run summon minecraft:block_display ~ ~2 ~ {Tags:["HCDragon_Shield","negative","layer4"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],scale:[8.5f,8.5f,8.5f],translation:[-4.25f,-4.25f,-4.25f]},block_state:{Name:glass},teleport_duration:1,Rotation:[-20f,-45f]}
