function earth{
    scoreboard players add @s wasd.timer 1
    kill @s[scores={wasd.timer=30..}]
    execute as @s[scores={wasd.timer=5..}] if entity @e[type=#wasd.tags:mobs_player,distance=..1.5] run block{
        execute as @e[type=#wasd.tags:mobs_player,distance=..1.5] run block{
            damage @s 4 minecraft:magic
            effect give @s levitation 1 80 true
            tag @s add wasd.lib_entity_tick
            tag @s add wasd.ability
            tag @s add wasd.remove_levitation
            summon item_display ~ ~-1.5 ~ {item_display:"head",brightness:{sky:10,block:15},Tags:["wasd.lib_entity_tick","wasd.ability","wasd.earth_spike"],teleport_duration:3,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[2.0f,2.0f,2.0f]},item:{id:"minecraft:armor_stand",count:1,components:{"minecraft:custom_model_data":6370320}}}
        }
        kill @s
    }
    particle dust_color_transition{from_color:[0.314, 0.176, 0.0], scale:2.0, to_color:[0.412, 0.302, 0.137]} ~ ~ ~ 0.2 0.2 0.2 0 2 force
    particle block{block_state:{Name:"minecraft:dirt"}} ~ ~ ~ 0.2 0 0.2 0 3 force
    particle falling_dust{block_state:{Name:"minecraft:dirt"}} ~ ~ ~ 0.2 0 0.2 0 3 force
    execute if block ~ ~ ~ #wasd.tags:nonsolid unless block ~ ~-1 ~ #wasd.tags:nonsolid run tp @s ^ ^ ^1
    execute if block ~ ~ ~ #wasd.tags:nonsolid if block ~ ~-1 ~ #wasd.tags:nonsolid run tp @s ^ ^-1 ^1
    execute unless block ~ ~ ~ #wasd.tags:nonsolid run tp @s ^ ^1 ^1

    execute if block ~ ~-2 ~ #wasd.tags:nonsolid run kill @s
    execute unless block ~ ~1 ~ #wasd.tags:nonsolid run kill @s
}
