

function determine_magic{
    execute as @s[tag=wasd.fireball] run function wasd.magic:fireball
    execute as @s[tag=wasd.meteor] run function wasd.magic:meteor_wand
    execute as @s[tag=wasd.flamethrower] run function wasd.magic:flamethrower
    execute as @s[tag=wasd.magma] run function wasd.magic:magma
    execute as @s[tag=wasd.ice] run function wasd.magic:ice
    execute as @s[tag=wasd.ice_spike] run function wasd.magic:ice_spike
    execute as @s[tag=wasd.frost] run function wasd.magic:frost
    execute as @s[tag=wasd.lightning] run function wasd.magic:lightning
    execute as @s[tag=wasd.thunder] run function wasd.magic:thunder
    execute as @s[tag=wasd.electric] run function wasd.magic:electric
    execute as @s[tag=wasd.air] run function wasd.magic:air
    execute as @s[tag=wasd.air_location] run function wasd.magic:air_location
    execute as @s[tag=wasd.wind] run function wasd.magic:wind
    execute as @s[tag=wasd.hurricane] run function wasd.magic:hurricane
    execute as @s[tag=wasd.gust] run function wasd.magic:gust
    execute as @s[tag=wasd.rock] run function wasd.magic:rock
    execute as @s[tag=wasd.boulder] run function wasd.magic:boulder
    execute as @s[tag=wasd.earth] run function wasd.magic:earth
    execute as @s[tag=wasd.earth_spike] run function wasd.magic:earth_spike
    execute as @s[tag=wasd.ore] run function wasd.magic:ore
    execute as @s[tag=wasd.steel_target] run function wasd.magic:steel_target
    execute as @s[tag=wasd.iron_spike] run function wasd.magic:iron_spike
    execute as @s[tag=wasd.darkness] run function wasd.magic:darkness
    execute as @s[tag=wasd.shadow] run function wasd.magic:shadow
    execute as @s[tag=wasd.cage] run function wasd.magic:cage
    execute as @s[tag=wasd.poison] run function wasd.magic:poison
    execute as @s[tag=wasd.dripstone] run function wasd.magic:dripstone
    execute as @s[tag=wasd.anvil] run function wasd.magic:anvil
    execute as @s[tag=wasd.water] run function wasd.magic:water
    execute as @s[tag=wasd.bubble] run function wasd.magic:bubble
    execute as @s[tag=wasd.bubble_visual] run function wasd.magic:bubble_visual
    execute as @s[tag=wasd.bubble_big] run function wasd.magic:bubble_big
    execute as @s[tag=wasd.kfc] run function wasd.magic:kfc
#new
    execute as @s[tag=wasd.healing_aura] run function wasd.magic:healing_aura
    execute as @s[tag=wasd.growing_aura] run function wasd.magic:growing_aura
    execute as @s[tag=wasd.plant_wand] run function wasd.magic:plant_wand
    execute as @s[tag=wasd.log_wand] run function wasd.magic:log_wand
    execute as @s[tag=wasd.log_spike] run function wasd.magic:log_spike
    execute as @s[tag=wasd.portal_projectile] run function wasd.magic:portal_projectile
    execute as @s[tag=wasd.circle_portal] run function wasd.magic:circle_portal
    execute as @s[tag=wasd.undead_projectile] run function wasd.magic:undead_projectile
    execute as @s[tag=wasd.zombie_arm] run function wasd.magic:zombie_arm
    execute as @s[tag=wasd.death_projectile] run function wasd.magic:death_projectile
    execute as @s[tag=wasd.draining_wand] run function wasd.magic:draining_wand
    execute as @s[tag=wasd.shadow_wand] run function wasd.magic:shadow_wand
